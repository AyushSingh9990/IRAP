NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# The application can boot with authentication disabled. To use registration/login,
# configure MongoDB, generate both secrets, then set both flags to true.
DATABASE_REQUIRED=false
MONGODB_URI=
DATABASE_NAME=irap

AUTH_ENABLED=false
APPLICATION_PAYMENT_REQUIRED=false
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=irap-server
JWT_AUDIENCE=irap-client
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
EMAIL_VERIFICATION_HOURS=24
PASSWORD_RESET_MINUTES=30
TWO_FACTOR_CODE_MINUTES=10

ACCESS_COOKIE_NAME=irap_access
REFRESH_COOKIE_NAME=irap_refresh
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax


# Private document storage. Local storage is suitable for development.
# Use cloudinary in production after adding all three Cloudinary credentials.
DOCUMENT_STORAGE_PROVIDER=local
DOCUMENT_LOCAL_DIRECTORY=private-uploads
DOCUMENT_MAX_FILE_SIZE_MB=10
DOCUMENT_SIGNED_URL_MINUTES=10

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Use log during local development. Verification/reset URLs are returned only
# in development API responses. Raw tokens are not written to logs. Use smtp in production.
MAIL_DELIVERY_MODE=log
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=iRAP
MAIL_FROM_ADDRESS=

# Payment configuration. Keep disabled until plans are created and a
# provider is configured. Never expose provider secrets in the client.
PAYMENTS_ENABLED=false
DEFAULT_CURRENCY=INR
PAYMENT_DEFAULT_PROVIDER=offline

RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

STRIPE_ENABLED=false
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

OFFLINE_PAYMENT_ENABLED=false
OFFLINE_PAYMENT_INSTRUCTIONS=
OFFLINE_PAYMENT_ACCOUNT_NAME=
OFFLINE_PAYMENT_ACCOUNT_REFERENCE=

RECAPTCHA_SECRET_KEY=

ADMIN_EMAIL=
ADMIN_PASSWORD=

LOG_LEVEL=info
TRUST_PROXY=1
